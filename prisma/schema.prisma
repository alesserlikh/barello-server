  DRINKS_FOOD
  NONFOOD
}

enum FacetType {
  CHIPS
  MULTISELECT
  RANGE
  TOGGLE
  BUCKET
}

enum FacetLevel {
  PRODUCT
  VARIANT
  OFFER
}

enum FacetScope {
  CATALOG
  VENUE_STOCK
  SUPPLIER_STOCK
  ADMIN_CATALOG
  PRICE_IMPORT
  MENU
  INVENTORY
}

enum FacetOptionSource {
  STATIC
  DYNAMIC
}

enum ContractSupplierStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum SponsoredPlacementType {
  CATEGORY_TOP
  SEARCH_TOP
  FEED_INLINE
  BANNER
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderBatchStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_SENT
  COMPLETED
  CANCELED
}

enum SupplierOrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  REJECTED
  CANCELED
}

enum SupplierOrderChannel {
  EMAIL
  API
  MANUAL
}

enum SupplierOrderStatusActorType {
  SUPPLIER
  SYSTEM
}

enum DeliveryConfirmationDecision {
  ACCEPTED
  REJECTED
}

enum UnitType {
  KG
  L
  PCS
  G
  ML
}

enum InventoryReservationReferenceType {
  ORDER
  MANUAL
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  WRITE_OFF
  RETURN
  MANUAL_RECEIPT
}

enum StockMovementReferenceType {
  ORDER
  MENU
  TECH_CARD
  INVENTORY
  MANUAL
  SALES_IMPORT
  INVENTORY_SESSION
}

enum StockAlertType {
  MISSING_INGREDIENT
  LOW_STOCK
  MANUAL_WARNING
}

enum MenuItemType {
  PRODUCT
  DISH
}

enum MenuItemTagType {
  MANUAL
  AUTO
}

enum InventorySessionStatus {
  IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  CLOSED
}

enum SalesImportStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum SalesImportSourceFormat {
  XLSX
  CSV
}

enum SalesReportRowMappingStatus {
  MATCHED
  UNMATCHED
  MANUAL_MATCHED
}

enum AnalyticsPeriodType {
  DAY
  WEEK
  MONTH
}

enum FileAssetType {
  IMAGE
  VIDEO
  DOCUMENT
  SPREADSHEET
  BANNER
  OTHER
}

enum ContentAuthorType {
  ADMIN
  SUPPLIER
}

enum ContentBannerLabel {
  NEW
}

enum BusinessDownloadPurpose {
  MENU
  STOCK
  SALES
  ANALYTICS
}

enum BusinessDownloadStatus {
  UPLOADED
  PROCESSING
  DONE
  FAILED
}

enum AuditActorType {
  USER
  SUPPLIER
  SYSTEM
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  publicId        String         @unique @default(dbgenerated("generate_public_id('1'::text)")) @db.VarChar(8)
  phone           String?        @unique
  email           String?        @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  status          UserStatus
  adminGroup      UserAdminGroup @default(UNCLASSIFIED)
  accountType     AccountType    @default(UNIDENTIFIED)
  activeVenueId   String?        @db.Uuid
  defaultVenueId  String?        @db.Uuid
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile                   UserProfile?
  activeVenue               Venue?                     @relation("UserActiveVenue", fields: [activeVenueId], references: [id], onDelete: SetNull)
  defaultVenue              Venue?                     @relation("UserDefaultVenue", fields: [defaultVenueId], references: [id], onDelete: SetNull)
  memberships               UserVenueMembership[]      @relation("UserMemberships")
  confirmedMemberships      UserVenueMembership[]      @relation("ConfirmedByUser")
  supplierMemberships       SupplierMembership[]
  registrationDrafts        RegistrationDraft[]
  createdStaffInvitations   StaffInvitation[]          @relation("CreatedStaffInvitations")
  acceptedInvitations       StaffInvitation[]          @relation("AcceptedStaffInvitation")
  companyModerationRequests CompanyModerationRequest[]

  authoredNotes                UserNote[]                  @relation("UserAuthoredNotes")
  noteAccesses                 UserNoteAccess[]
  createdTasks                 UserTask[]                  @relation("UserCreatedTasks")
  assignedTasks                UserTask[]                  @relation("UserAssignedTasks")
  authSessions                 AuthSession[]
  verificationCodes            VerificationCode[]
  favoriteProducts             UserFavoriteProduct[]
  carts                        Cart[]                      @relation("UserCreatedCarts")
  orderBatches                 OrderBatch[]                @relation("UserCreatedOrderBatches")
  deliveryConfirmations        OrderDeliveryConfirmation[]
  inventoryReservations        InventoryReservation[]      @relation("InventoryReservationReservedBy")
  inventorySessions            InventorySession[]          @relation("InventorySessionCreatedBy")
  inventorySessionItemsCounted InventorySessionItem[]      @relation("InventorySessionItemCountedBy")
  salesReportImports           SalesReportImport[]         @relation("SalesReportImportUploadedBy")
  menuItemTagsCreated          MenuItemTag[]               @relation("MenuItemTagCreatedBy")
  menuItemAnalogsAssigned      MenuItemAnalog[]            @relation("MenuItemAnalogAssignedBy")
  fileAssetsUploaded           FileAsset[]                 @relation("FileAssetUploadedByUser")
  auditLogsActor               AuditLog[]                  @relation("AuditLogActorUser")
  accountDeletionRequests      AccountDeletionRequest[]
  notifications                Notification[]
  taskSettings                 UserTaskSettings?
  businessDownloads            BusinessDownload[]          @relation("BusinessDownloadUploadedBy")
  catalogFilterPresets         UserCatalogFilterPreset[]
  contentStoryViews            ContentStoryView[]
  contentStoryReactions        ContentStoryReaction[]
  contentStoryReplies          ContentStoryReply[]

  @@index([activeVenueId])
  @@index([defaultVenueId])
}

model UserProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  firstName    String
  lastName     String
  middleName   String?
  avatarFileId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserVenueMembership {
  id                String           @id @default(uuid()) @db.Uuid
  publicId          String           @unique @default(dbgenerated("generate_public_id('4'::text)")) @db.VarChar(8)
  userId            String           @db.Uuid
  venueId           String           @db.Uuid
  displayRole       DisplayRole
  accessLevel       AccessLevel
  membershipStatus  MembershipStatus
  joinedAt          DateTime?
  confirmedByUserId String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User  @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  venue           Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  confirmedByUser User? @relation("ConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, venueId])
  @@index([venueId])
  @@index([confirmedByUserId])
}

model UserNote {
  id           String    @id @default(uuid()) @db.Uuid
  authorUserId String    @db.Uuid
  venueId      String?   @db.Uuid
  scope        NoteScope @default(PRIVATE)
  title        String
  content      String    @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author   User             @relation("UserAuthoredNotes", fields: [authorUserId], references: [id], onDelete: Cascade)
  venue    Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  accesses UserNoteAccess[]

  @@index([authorUserId])
  @@index([venueId])
  @@index([scope, createdAt])
}

model UserNoteAccess {
  id        String    @id @default(uuid()) @db.Uuid
  noteId    String    @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime  @default(now())
  readAt    DateTime?

  note UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
}

model UserTask {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  description    String?        @db.Text
  status         TaskStatus     @default(TODO)
  priority       TaskPriority   @default(MEDIUM)
  visibility     TaskVisibility @default(PRIVATE)
  creatorUserId  String         @db.Uuid
  assigneeUserId String         @db.Uuid
  venueId        String?        @db.Uuid
  dueDate        DateTime?
  onboardingKey  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  creator  User   @relation("UserCreatedTasks", fields: [creatorUserId], references: [id], onDelete: Cascade)
  assignee User   @relation("UserAssignedTasks", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  venue    Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([assigneeUserId, onboardingKey])
  @@index([creatorUserId])
  @@index([assigneeUserId])
  @@index([venueId])
  @@index([status])
  @@index([dueDate])
}

model UserTaskSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  weekStartsOn         Int      @default(1)
  showCompleted        Boolean  @default(true)
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  title              String
  description        String    @db.Text
  type               String
  isRead             Boolean   @default(false)
  readAt             DateTime?
  relatedEntityType  String?
  relatedEntityId    String?
  relatedEntityRoute String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuthSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationCode {
  id        String               @id @default(uuid()) @db.Uuid
  target    String
  code      String
  type      VerificationCodeType
  userId    String?              @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([target, type])
  @@index([expiresAt])
}

model Business {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  taxNumber    String   @unique
  legalAddress String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venues                    Venue[]
  supplier                  Supplier?
  registrationDrafts        RegistrationDraft[]
  companyModerationRequests CompanyModerationRequest[]
}

model Venue {
  id                           String            @id @default(uuid()) @db.Uuid
  publicId                     String            @unique @default(dbgenerated("generate_public_id('3'::text)")) @db.VarChar(8)
  businessId                   String            @db.Uuid
  name                         String
  city                         String
  address                      String?
  latitude                     Decimal?          @db.Decimal(9, 6)
  longitude                    Decimal?          @db.Decimal(9, 6)
  phone                        String?
  email                        String?
  website                      String?
  contactPersonName            String?
  seatsCount                   Int?
  description                  String?           @db.Text
  venueType                    String?
  mainPhotoFileId              String?           @db.Uuid
  showPhoneInCard              Boolean           @default(false)
  showAdminContactsToSuppliers Boolean           @default(false)
  ownerStatus                  VenueOwnerStatus?
  venueStatus                  VenueStatus       @default(ACTIVE)
  isActive                     Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  activeForUsers            User[]                     @relation("UserActiveVenue")
  defaultForUsers           User[]                     @relation("UserDefaultVenue")
  memberships               UserVenueMembership[]
  cuisineLinks              VenueCuisineType[]
  photos                    VenuePhoto[]
  notes                     UserNote[]
  businessDownloads         BusinessDownload[]
  tasks                     UserTask[]
  supplierSpecialConditions SupplierSpecialCondition[]
  contractSuppliers         ContractSupplier[]
  favoriteProducts          UserFavoriteProduct[]
  carts                     Cart[]
  orderBatches              OrderBatch[]
  supplierOrders            SupplierOrder[]
  inventoryItems            InventoryItem[]
  inventoryReservations     InventoryReservation[]
  stockMovements            StockMovement[]
  stockAlerts               StockAlert[]
  stopListItems             StopListItem[]
  menuCategories            MenuCategory[]
  menuItems                 MenuItem[]
  menuItemTags              MenuItemTag[]
  pairingStats              MenuItemPairingStat[]
  inventorySessions         InventorySession[]
  salesReportImports        SalesReportImport[]
  salesReportRows           SalesReportRow[]
  analyticsSnapshots        VenueAnalyticsSnapshot[]
  registrationDrafts        RegistrationDraft[]
  staffInvitations          StaffInvitation[]

  @@index([businessId])
  @@index([venueStatus])
}

model CuisineType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  venues VenueCuisineType[]
}

model VenueCuisineType {
  id            String   @id @default(uuid()) @db.Uuid
  venueId       String   @db.Uuid
  cuisineTypeId String   @db.Uuid
  createdAt     DateTime @default(now())

  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  cuisineType CuisineType @relation(fields: [cuisineTypeId], references: [id], onDelete: Cascade)

  @@unique([venueId, cuisineTypeId])
  @@index([cuisineTypeId])
}

model Supplier {
  id              String              @id @default(uuid()) @db.Uuid
  publicId        String              @unique @default(dbgenerated("generate_public_id('2'::text)")) @db.VarChar(8)
  businessId      String?             @unique @db.Uuid
  name            String
  catalogName     String?
  city            String?
  address         String?
  latitude        Decimal?            @db.Decimal(9, 6)
  longitude       Decimal?            @db.Decimal(9, 6)
  contactName     String?
  description     String?             @db.Text
  phone           String?
  email           String?
  website         String?
  passwordHash    String?
  pinHash         String?
  mainPhotoFileId String?             @db.Uuid
  showPhoneInCard Boolean             @default(false)
  planName        String?
  planStatus      SupplierPlanStatus?
  promoBalance    Decimal?            @db.Decimal(12, 2)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business                  Business?                   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  categories                SupplierCategory[]
  catalogCategoryMappings   CatalogCategoryMapping[]
  specialConditions         SupplierSpecialCondition[]
  photos                    SupplierPhoto[]
  importProfiles            SupplierImportProfile[]
  priceImports              SupplierPriceImport[]
  priceImportIssues         SupplierPriceImportIssue[]
  catalogNormalizedRows     CatalogNormalizedRow[]
  catalogValidationIssues   CatalogValidationIssue[]
  catalogPublishBatches     CatalogPublishBatch[]
  productAliases            SupplierProductAlias[]
  productCandidates         ProductCandidate[]
  importImageMatches        SupplierImportImageMatch[]
  stockImports              SupplierStockImport[]
  inventoryItems            SupplierInventoryItem[]
  regionPresences           SupplierRegionPresence[]
  supplierProducts          SupplierProduct[]
  contractSuppliers         ContractSupplier[]
  categoryBanners           CatalogCategoryBanner[]
  catalogBanners            CatalogBanner[]
  sponsoredPlacements       SponsoredProductPlacement[]
  searchSuggestions         CatalogSearchSuggestion[]
  supplierOrders            SupplierOrder[]
  supplierOrderStatusEvents SupplierOrderStatusEvent[]
  fileAssetsUploaded        FileAsset[]                 @relation("FileAssetUploadedBySupplier")
  auditLogsActor            AuditLog[]                  @relation("AuditLogActorSupplier")
  memberships               SupplierMembership[]

  @@index([businessId])
}

model VenuePhoto {
  id          String           @id @default(uuid()) @db.Uuid
  venueId     String           @db.Uuid
  fileAssetId String           @db.Uuid
  sortOrder   Int              @default(0)
  status      VenuePhotoStatus @default(ACTIVE)
  rejectedAt  DateTime?
  createdAt   DateTime         @default(now())

  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([fileAssetId])
  @@index([status])
}

model SupplierPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @db.Uuid
  fileAssetId String   @db.Uuid
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([fileAssetId])
}

model RegistrationDraft {
  id                       String                  @id @default(uuid()) @db.Uuid
  flowType                 RegistrationFlowType
  status                   RegistrationDraftStatus @default(IN_PROGRESS)
  userId                   String?                 @db.Uuid
  fullName                 String?
  phone                    String?
  phoneOtpVerified         Boolean                 @default(false)
  selectedAccountType      AccountType?
  venueRole                DisplayRole?
  supplierRole             String?
  supplierAccessLevel      AccessLevel?
  venueAccessLevel         AccessLevel?
  inn                      String?
  companyExistsInBarello   Boolean?
  existingCompanyType      CompanyType?
  existingCompanyId        String?                 @db.Uuid
  externalCompanyConfirmed Boolean?
  externalCompanyData      Json?
  manualCompanyName        String?
  manualCompanyAddress     String?
  inviteToken              String?
  staffInvitationId        String?                 @db.Uuid
  venueId                  String?                 @db.Uuid
  businessId               String?                 @db.Uuid
  invitedRole              DisplayRole?
  invitedAccessLevel       AccessLevel?
  expiresAt                DateTime
  completedAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  user                      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffInvitation           StaffInvitation?           @relation(fields: [staffInvitationId], references: [id], onDelete: SetNull)
  venue                     Venue?                     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  business                  Business?                  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  companyModerationRequests CompanyModerationRequest[]

  @@index([userId])
  @@index([staffInvitationId])
  @@index([venueId])
  @@index([businessId])
  @@index([phone])
  @@index([status])
  @@index([flowType])
  @@index([expiresAt])
}

model StaffInvitation {
  id                 String                @id @default(uuid()) @db.Uuid
  venueId            String                @db.Uuid
  inviterUserId      String                @db.Uuid
  invitedRole        DisplayRole
  invitedAccessLevel AccessLevel
  status             StaffInvitationStatus @default(CREATED)
  currentTokenHash   String
  inviteUrl          String
  expiresAt          DateTime
  acceptedByUserId   String?               @db.Uuid
  acceptedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  inviterUser        User                @relation("CreatedStaffInvitations", fields: [inviterUserId], references: [id], onDelete: Cascade)
  acceptedByUser     User?               @relation("AcceptedStaffInvitation", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  registrationDrafts RegistrationDraft[]

  @@index([venueId])
  @@index([inviterUserId])
  @@index([acceptedByUserId])
  @@index([status])
  @@index([expiresAt])
}

model CompanyModerationRequest {
