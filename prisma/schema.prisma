  @@index([menuItemId])
  @@index([venueId])
  @@index([createdByUserId])
}

model MenuItemAnalog {
  id               String   @id @default(uuid()) @db.Uuid
  menuItemId       String   @db.Uuid
  analogMenuItemId String   @db.Uuid
  assignedByUserId String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  menuItem       MenuItem @relation("MenuItemAnalogBase", fields: [menuItemId], references: [id], onDelete: Cascade)
  analogMenuItem MenuItem @relation("MenuItemAnalogAnalog", fields: [analogMenuItemId], references: [id], onDelete: Cascade)
  assignedByUser User     @relation("MenuItemAnalogAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([menuItemId])
  @@index([analogMenuItemId])
  @@index([assignedByUserId])
}

model MenuItemPairingStat {
  id               String   @id @default(uuid()) @db.Uuid
  venueId          String   @db.Uuid
  menuItemId       String   @db.Uuid
  pairedMenuItemId String   @db.Uuid
  pairingCount     Int      @default(0)
  lastUpdatedAt    DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItem       MenuItem @relation("MenuItemPairingBase", fields: [menuItemId], references: [id], onDelete: Cascade)
  pairedMenuItem MenuItem @relation("MenuItemPairingPaired", fields: [pairedMenuItemId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([menuItemId])
  @@index([pairedMenuItemId])
