model TechCard {
  id             String   @id @default(uuid()) @db.Uuid
  menuItemId     String   @unique @db.Uuid
  outputQuantity Decimal  @db.Decimal(12, 3)
  outputUnit     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menuItem    MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients TechCardIngredient[]
}

model TechCardIngredient {
  id              String   @id @default(uuid()) @db.Uuid
  techCardId      String   @db.Uuid
  inventoryItemId String   @db.Uuid
  quantity        Decimal  @db.Decimal(12, 3)
  unit            UnitType
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  techCard      TechCard      @relation(fields: [techCardId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([techCardId])
  @@index([inventoryItemId])
}

model InventorySession {
  id              String                 @id @default(uuid()) @db.Uuid
  venueId         String                 @db.Uuid
  createdByUserId String                 @db.Uuid
  status          InventorySessionStatus
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  venue         Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdByUser User                   @relation("InventorySessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         InventorySessionItem[]

  @@index([venueId])
  @@index([createdByUserId])
  @@index([status])
}

model InventorySessionItem {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @db.Uuid
  inventoryItemId String    @db.Uuid
  expectedQty     Decimal   @db.Decimal(12, 3)
  actualQty       Decimal?  @db.Decimal(12, 3)
  expectedUnit    UnitType
  actualUnit      UnitType?
  differenceQty   Decimal?  @db.Decimal(12, 3)
  differenceValue Decimal?  @db.Decimal(12, 2)
  note            String?   @db.Text
  countedByUserId String?   @db.Uuid
  countedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session       InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  countedByUser User?            @relation("InventorySessionItemCountedBy", fields: [countedByUserId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([inventoryItemId])
  @@index([countedByUserId])
}

model UnitConversionProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @unique @db.Uuid
  catalogUnit         String?
  inventoryBaseUnit   String
  menuSaleUnit        String?
  inventoryInputUnit  String?
  baseToInputFactor   Decimal? @db.Decimal(18, 6)
  catalogToBaseFactor Decimal? @db.Decimal(18, 6)
  menuToBaseFactor    Decimal? @db.Decimal(18, 6)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SalesReportImport {
  id               String                  @id @default(uuid()) @db.Uuid
  venueId          String                  @db.Uuid
  fileAssetId      String                  @db.Uuid
  status           SalesImportStatus       @default(PENDING)
  sourceFormat     SalesImportSourceFormat
  uploadedByUserId String                  @db.Uuid
  periodStart      DateTime?               @db.Date
  periodEnd        DateTime?               @db.Date
  rowsCount        Int                     @default(0)
  processedRows    Int                     @default(0)
  failedRows       Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  uploadedByUser User             @relation("SalesReportImportUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  rows           SalesReportRow[]

  @@index([venueId])
  @@index([uploadedByUserId])
  @@index([status])
}

model SalesReportRow {
  id               String                      @id @default(uuid()) @db.Uuid
  importId         String                      @db.Uuid
  venueId          String                      @db.Uuid
  rawName          String
  rawCategory      String?
  mappedMenuItemId String?                     @db.Uuid
  quantity         Decimal                     @db.Decimal(12, 3)
  revenue          Decimal                     @db.Decimal(12, 2)
  costAmount       Decimal?                    @db.Decimal(12, 2)
  marginAmount     Decimal?                    @db.Decimal(12, 2)
  saleDate         DateTime?                   @db.Date
  mappingStatus    SalesReportRowMappingStatus
  rawPayload       Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  import         SalesReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  venue          Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  mappedMenuItem MenuItem?         @relation(fields: [mappedMenuItemId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([venueId])
  @@index([mappedMenuItemId])
  @@index([mappingStatus])
}

model VenueAnalyticsSnapshot {
  id                  String              @id @default(uuid()) @db.Uuid
  venueId             String              @db.Uuid
  periodType          AnalyticsPeriodType
  periodStart         DateTime            @db.Date
  periodEnd           DateTime            @db.Date
  stockValue          Decimal?            @db.Decimal(12, 2)
  lowStockCount       Int                 @default(0)
  stopListCount       Int                 @default(0)
  purchaseAmount      Decimal?            @db.Decimal(12, 2)
  salesRevenue        Decimal?            @db.Decimal(12, 2)
  salesCost           Decimal?            @db.Decimal(12, 2)
  salesMargin         Decimal?            @db.Decimal(12, 2)
  writeOffAmount      Decimal?            @db.Decimal(12, 2)
  inventoryDifference Decimal?            @db.Decimal(12, 2)
  priceGrowthCount    Int                 @default(0)
  topItemsJson        Json?
  worstItemsJson      Json?
  stopListItemsJson   Json?
  pairingStatsJson    Json?
  stockForecastJson   Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([periodType, periodStart, periodEnd])
}

model FileAsset {
  id                   String        @id @default(uuid()) @db.Uuid
  storageKey           String        @unique
  fileName             String
  mimeType             String
  fileSize             Int
  type                 FileAssetType
  uploadedByUserId     String?       @db.Uuid
  uploadedBySupplierId String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  uploadedByUser             User?                      @relation("FileAssetUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedBySupplier         Supplier?                  @relation("FileAssetUploadedBySupplier", fields: [uploadedBySupplierId], references: [id], onDelete: SetNull)
  venuePhotos                VenuePhoto[]
  supplierPhotos             SupplierPhoto[]
  supplierPriceImports       SupplierPriceImport[]      @relation("SupplierPriceImportFile")
  supplierStockImports       SupplierStockImport[]
  supplierImportImageMatches SupplierImportImageMatch[]
  productMediaAssets         ProductMediaAsset[]
  productBarcodeImages       Product[]                  @relation("ProductBarcodeImage")
  productMainImages          Product[]                  @relation("ProductMainImage")
  productPromoVideos         Product[]                  @relation("ProductPromoVideo")
  catalogNormalizedRowImages CatalogNormalizedRow[]     @relation("CatalogNormalizedRowImage")
  businessDownload           BusinessDownload?

  @@index([uploadedByUserId])
  @@index([uploadedBySupplierId])
}

model ContentStory {
  id              String            @id @default(uuid()) @db.Uuid
  authorType      ContentAuthorType
  adminAuthorName String?
  supplierId      String?           @db.Uuid
  fileAssetId     String            @db.Uuid
  title           String?
  location        String?
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  views     ContentStoryView[]
  reactions ContentStoryReaction[]
  replies   ContentStoryReply[]

  @@index([authorType, isActive, sortOrder])
  @@index([supplierId])
  @@index([fileAssetId])
  @@index([isActive, expiresAt, sortOrder])
}

model ContentStoryView {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  story ContentStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId, createdAt])
}

model ContentStoryReaction {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  reaction  String   @db.VarChar(24)
  createdAt DateTime @default(now())

  story ContentStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([userId, createdAt])
}

model ContentStoryReply {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  message   String   @db.Text
  createdAt DateTime @default(now())

  story ContentStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([userId, createdAt])
}

model HomeBannerContent {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(20)
  label       ContentBannerLabel @default(NEW)
  bodyText    String             @db.Text
  lead        String             @db.Text
  cta         String
  fileAssetId String             @db.Uuid
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, sortOrder])
  @@index([fileAssetId])
}

model BusinessDownload {
  id               String                  @id @default(uuid()) @db.Uuid
  venueId          String                  @db.Uuid
  fileAssetId      String                  @unique @db.Uuid
  uploadedByUserId String?                 @db.Uuid
  purpose          BusinessDownloadPurpose
  status           BusinessDownloadStatus  @default(UPLOADED)
  processingError  String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("BusinessDownloadUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
  @@index([uploadedByUserId])
  @@index([status])
}

model SupplierRegionPresence {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  regionCode String
  regionName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, regionCode])
  @@index([supplierId])
}

model AuditLog {
  id              String         @id @default(uuid()) @db.Uuid
  actorType       AuditActorType
  actorUserId     String?        @db.Uuid
  actorSupplierId String?        @db.Uuid
  entityType      String
  entityId        String?        @db.Uuid
  action          String
  payload         Json?
  createdAt       DateTime       @default(now())

  actorUser     User?     @relation("AuditLogActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorSupplier Supplier? @relation("AuditLogActorSupplier", fields: [actorSupplierId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([actorSupplierId])
  @@index([entityType, entityId])
  @@index([action])
}

model AccountDeletionRequest {
  id                       String                       @id @default(uuid()) @db.Uuid
  userId                   String                       @db.Uuid
  status                   AccountDeletionRequestStatus @default(PENDING)
  requestedReason          String?                      @db.Text
  requestedAt              DateTime                     @default(now())
  scheduledDeletionAt      DateTime
  executedAt               DateTime?
  executedByModeratorId    String?
  executedByModeratorEmail String?
  executionReason          String?                      @db.Text
  cancelledAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledDeletionAt])
}
