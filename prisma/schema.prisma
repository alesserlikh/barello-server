  UNIDENTIFIED
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum UserAdminGroup {
  UNCLASSIFIED
  REAL
  TEST
  INTERNAL_TEST
}

enum AccountDeletionRequestStatus {
  PENDING
  EXECUTED
  CANCELLED
}

enum AccessLevel {
  ADMIN
  SENIOR_STAFF
  LINE_STAFF
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum DisplayRole {
  OWNER
  ADMINISTRATOR
  BAR_MANAGER
  SENIOR_BARTENDER
  SOMMELIER
  BARTENDER
  WAITER
}

enum AccountType {
  VENUE_STAFF
  SUPPLIER_STAFF
  UNIDENTIFIED
}

enum RegistrationFlowType {
  DIRECT
  INVITE_TOKEN
}

enum RegistrationDraftStatus {
